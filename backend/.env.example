# Server
PORT=3001
NODE_ENV=development

# CORS — frontend URL
CORS_ORIGIN=http://localhost:3000

# Temporary file storage
TEMP_DIR=./temp
MAX_FILE_AGE_MINUTES=15

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30
RATE_LIMIT_DOWNLOAD_MAX=10

# tmpfiles.org upload expiration (48 hours in seconds)
TMPFILES_EXPIRE_SECONDS=172800
